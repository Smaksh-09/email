generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  RATE_LIMITED
  SENT
  FAILED
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  name             String
  avatarUrl        String?
  googleId         String      @unique

  // Slack Integration
  slackAccessToken String?
  slackChannelId   String?
  slackWebhookUrl  String?
  slackTeamName    String?

  senders          Sender[]
  campaigns        Campaign[]
  emails           EmailJob[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Sender {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  email            String      @unique
  name             String
  smtpHost         String      @default("smtp.ethereal.email")
  smtpPort         Int         @default(587)
  smtpUser         String
  smtpPass         String
  
  hourlyLimit      Int         @default(50)
  minDelaySeconds  Int         @default(2)

  emails           EmailJob[]
  campaigns        Campaign[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
}

model Campaign {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId         String
  sender           Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  subject          String
  body             String
  startTime        DateTime
  delayBetweenSec  Int
  hourlyLimit      Int
  totalLeads       Int

  emails           EmailJob[]
  createdAt        DateTime    @default(now())
}

model EmailJob {
  id               String      @id @default(uuid())
  idempotencyKey   String      @unique
  
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId         String
  sender           Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  recipientEmail   String
  subject          String
  body             String

  status           EmailStatus @default(SCHEDULED)
  scheduledAt      DateTime
  sentAt           DateTime?
  
  bullJobId        String?     @unique
  messageId        String?     // SMTP Message-ID returned by Ethereal
  previewUrl       String?     // Ethereal preview URL for easy demo verification
  
  attempts         Int         @default(0)
  errorMessage     String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, status])
  @@index([senderId, scheduledAt])
}