# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reachinbox_db"

# Server
PORT=5000

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Google OAuth (Add your credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/auth/google/callback"

# Session Secret
SESSION_SECRET="your-random-session-secret-change-this-in-production"

# Slack (Optional - for Slack integration)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
